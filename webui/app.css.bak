/* clashx Web UI —— 浅色主题，跟随系统偏好 */
:root {
  --bg: #f7f7f5;
  --surface: #ffffff;
  --border: #e3e1da;
  --text: #1c1b19;
  --text-dim: #6b6963;
  --accent: #185fa5;
  --accent-soft: #e6f1fb;
  --ok: #1d9e75;
  --ok-soft: #e1f5ee;
  --warn: #ba7517;
  --warn-soft: #faeeda;
  --err: #a32d2d;
  --err-soft: #fcebeb;
  --radius: 10px;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #1a1a18;
    --surface: #242422;
    --border: #3a3a37;
    --text: #e8e6e0;
    --text-dim: #9a978f;
    --accent: #85b7eb;
    --accent-soft: #1c2e40;
    --ok: #5dcaa5;
    --ok-soft: #16352a;
    --warn: #ef9f27;
    --warn-soft: #3a2a10;
    --err: #f09595;
    --err-soft: #3d1a1a;
  }
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font: 14px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
        "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

code, pre, .mono { font-family: var(--mono); font-size: 13px; }

/* ---- 布局 ---- */
.wrap { max-width: 1080px; margin: 0 auto; padding: 24px 20px 64px; }

header.top {
  display: flex; align-items: center; gap: 12px;
  padding-bottom: 16px; margin-bottom: 20px;
  border-bottom: 1px solid var(--border);
}
header.top h1 { font-size: 17px; font-weight: 500; margin: 0; }
header.top .spacer { flex: 1; }

nav.tabs { display: flex; gap: 4px; margin-bottom: 20px; flex-wrap: wrap; }
nav.tabs button {
  background: none; border: none; cursor: pointer;
  padding: 7px 14px; border-radius: var(--radius);
  color: var(--text-dim); font-size: 14px; font-family: inherit;
}
nav.tabs button:hover { background: var(--surface); color: var(--text); }
nav.tabs button[aria-selected="true"] {
  background: var(--accent-soft); color: var(--accent); font-weight: 500;
}

/* ---- 卡片 ---- */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px 20px;
  margin-bottom: 16px;
}
.card h2 {
  font-size: 14px; font-weight: 500; margin: 0 0 14px;
  display: flex; align-items: center; gap: 8px;
}
.card h2 .spacer { flex: 1; }

.grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }

.stat { padding: 12px 14px; background: var(--bg); border-radius: 8px; }
.stat .k { font-size: 12px; color: var(--text-dim); }
.stat .v { font-size: 20px; margin-top: 2px; font-variant-numeric: tabular-nums; }

/* ---- 徽标 ---- */
.badge {
  display: inline-block; padding: 2px 9px; border-radius: 20px;
  font-size: 12px; font-weight: 500; line-height: 1.6;
}
.badge.ok { background: var(--ok-soft); color: var(--ok); }
.badge.err { background: var(--err-soft); color: var(--err); }
.badge.warn { background: var(--warn-soft); color: var(--warn); }
.badge.dim { background: var(--bg); color: var(--text-dim); }

/* ---- 按钮 ---- */
button.btn {
  background: var(--surface); color: var(--text);
  border: 1px solid var(--border); border-radius: 8px;
  padding: 6px 14px; cursor: pointer; font-size: 14px; font-family: inherit;
}
button.btn:hover { border-color: var(--accent); color: var(--accent); }
button.btn:disabled { opacity: .5; cursor: not-allowed; }
button.btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
button.btn.primary:hover { opacity: .88; color: #fff; }
button.btn.danger { color: var(--err); border-color: var(--err); }
button.btn.danger:hover { background: var(--err-soft); color: var(--err); }
button.btn.sm { padding: 3px 10px; font-size: 13px; }

.btnrow { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }

/* ---- 表单 ---- */
input[type=text], input[type=password], textarea, select {
  width: 100%; padding: 7px 11px;
  background: var(--bg); color: var(--text);
  border: 1px solid var(--border); border-radius: 8px;
  font: inherit;
}
input:focus, textarea:focus { outline: none; border-color: var(--accent); }
textarea { min-height: 320px; resize: vertical; }
label.field { display: block; margin-bottom: 12px; }
label.field > span { display: block; font-size: 13px; color: var(--text-dim); margin-bottom: 4px; }

/* ---- 列表 ---- */
ul.list { list-style: none; margin: 0; padding: 0; }
ul.list li {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 0; border-bottom: 1px solid var(--border);
}
ul.list li:last-child { border-bottom: none; }
ul.list li .grow { flex: 1; min-width: 0; }
ul.list li .mono { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ---- 模式选择 ---- */
.modes { display: grid; gap: 8px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
.mode {
  text-align: left; padding: 12px 14px; cursor: pointer;
  background: var(--bg); color: var(--text);
  border: 1px solid var(--border); border-radius: 8px; font-family: inherit;
}
.mode:hover { border-color: var(--accent); }
.mode[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); }
.mode .n { font-weight: 500; font-size: 14px; }
.mode .d { font-size: 12px; color: var(--text-dim); margin-top: 2px; }

/* ---- 提示 ---- */
.msg { padding: 9px 13px; border-radius: 8px; margin-bottom: 12px; font-size: 13px; }
.msg.ok { background: var(--ok-soft); color: var(--ok); }
.msg.err { background: var(--err-soft); color: var(--err); }
.msg.info { background: var(--accent-soft); color: var(--accent); }

.hint { font-size: 12px; color: var(--text-dim); margin-top: 6px; }

pre.out {
  background: var(--bg); border: 1px solid var(--border);
  border-radius: 8px; padding: 12px; overflow: auto;
  max-height: 460px; margin: 0; font-size: 12.5px; line-height: 1.55;
}

.empty { color: var(--text-dim); text-align: center; padding: 28px 0; }
.spin { color: var(--text-dim); padding: 28px 0; text-align: center; }

a { color: var(--accent); }
a.btn { text-decoration: none; display: inline-block; }
